{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "job", "from", "to", "transport-scale", "transport-rays", "plate-every"],
  "properties": {
    "version": {"const": 1},
    "job": {"type": "string", "minLength": 1},
    "from": {"type": "integer", "minimum": 0},
    "to": {"type": "integer", "minimum": 1},
    "transport-scale": {"enum": [1, 2, 4]},
    "transport-rays": {"type": "integer", "minimum": 1, "maximum": 4},
    "plate-every": {"type": "integer", "minimum": 1}
  }
}
