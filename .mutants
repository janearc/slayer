# Native layout parity, error results and allocation hints.
metal/acceleration.go NewAcceleration: stride < 12 || stride%4 != 0 || len(vertices)%stride != 0 || (len(vertices)/stride)%3 != 0 || len(vertices) > math.MaxInt32 => stride < 12 || stride%4 != 0 || len(vertices)%stride != 0 || (len(vertices)/stride)%3 != 0 || len(vertices) >= math.MaxInt32 :: a valid layout has byte length divisible by its four-byte-aligned stride; MaxInt32 is odd, so equality is already refused by the layout guards
metal/acceleration.go Triangles: return 0, errors.New("metal: no acceleration plan") => return 1, errors.New("metal: no acceleration plan") :: a node index has meaning only on success; both versions return the same refusal, and no node is appended
metal/acceleration.go Triangles: return 0, errors.New("metal: triangle range outside the vertices") => return 1, errors.New("metal: triangle range outside the vertices") :: a node index has meaning only on success; both versions return the same refusal, and no node is appended
metal/acceleration.go Instances: return 0, errors.New("metal: no acceleration plan or too many nodes") => return 1, errors.New("metal: no acceleration plan or too many nodes") :: a node index has meaning only on success; both versions return the same refusal, and no node is appended
metal/acceleration.go Instances: return 0, errors.New("metal: too many instance placements") => return 1, errors.New("metal: too many instance placements") :: a node index has meaning only on success; both versions return the same refusal, and no node is appended
metal/acceleration.go Instances: return 0, errors.New("metal: instance needs an earlier child and valid transform") => return 1, errors.New("metal: instance needs an earlier child and valid transform") :: a node index has meaning only on success; both versions return the same refusal, and no node is appended
metal/acceleration.go Accelerate: nodes := make([]int32, 0, len(plan.nodes)*3) => nodes := make([]int32, 0, len(plan.nodes)/3) :: only initial capacity of the private node slice changes; append supplies the same complete triples before C reads them
metal/acceleration.go Accelerate: nodes := make([]int32, 0, len(plan.nodes)*3) => nodes := make([]int32, 0, len(plan.nodes)*4) :: only initial capacity of the private node slice changes; append supplies the same complete triples before C reads them
metal/grid.go Grid: rows <= 0 || rows > height => rows <= 0 || rows >= height :: at rows==height the assignment rows=height is an identity; every other row count takes the same path

# Unused legacy metadata and exact sign/lattice operations.
manufacture/kinds.go made: err != nil || from.draw(picking, 0, 0) < row.upright => err != nil || from.draw(picking, 0, 0) <= row.upright :: the sole public can row uses binary64(0.3), which lies halfway between draw lattice points (0.3*2^53=2702159776422297.5); equality is unreachable
manufacture/redwoods.go redwoodRow: row.grows.shoots.wear = sleeveFoliage{joints: lengths(0.05, 0.09, 0), sides: 4} => row.grows.shoots.wear = sleeveFoliage{joints: lengths(1.1, 0.09, 0), sides: 4} :: these sleeve radii and cuts still pass scaffold validation; recursiveFoliage discards their surfaces and reads only terminal role, tube length and placement before building physical shoots
manufacture/redwoods.go redwoodRow: row.grows.shoots.wear = sleeveFoliage{joints: lengths(0.05, 0.09, 0), sides: 4} => row.grows.shoots.wear = sleeveFoliage{joints: lengths(0.05, 1.18, 0), sides: 4} :: these sleeve radii and cuts still pass scaffold validation; recursiveFoliage discards their surfaces and reads only terminal role, tube length and placement before building physical shoots
manufacture/redwoods.go redwoodRow: row.grows.shoots.wear = sleeveFoliage{joints: lengths(0.05, 0.09, 0), sides: 4} => row.grows.shoots.wear = sleeveFoliage{joints: lengths(0.05, 0.09, 1), sides: 4} :: these sleeve radii and cuts still pass scaffold validation; recursiveFoliage discards their surfaces and reads only terminal role, tube length and placement before building physical shoots
manufacture/redwoods.go redwoodRow: row.grows.shoots.wear = sleeveFoliage{joints: lengths(0.05, 0.09, 0), sides: 4} => row.grows.shoots.wear = sleeveFoliage{joints: lengths(0.05, 0.09, 0), sides: 5} :: these sleeve radii and cuts still pass scaffold validation; recursiveFoliage discards their surfaces and reads only terminal role, tube length and placement before building physical shoots
