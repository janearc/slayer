firefront/front.go New: !pointOK(spec.Origin) || !pointOK(spec.Direction) || spec.Direction.Y != 0 || !(spec.Direction.Len() > 0) || !finite(spec.Direction.Len()) || !(spec.Speed > 0) || !finite(spec.Speed) || !(spec.Cell > 0) || !finite(spec.Cell) || spec.Start < -24*time.Hour || spec.Start > 24*time.Hour || spec.Duration <= 0 || spec.Duration > 24*time.Hour || len(targets) == 0 || len(targets) > 100000 => !pointOK(spec.Origin) || !pointOK(spec.Direction) || spec.Direction.Y != 0 || !(spec.Direction.Len() > 0) || !finite(spec.Direction.Len()) || !(spec.Speed >= 0) || !finite(spec.Speed) || !(spec.Cell > 0) || !finite(spec.Cell) || spec.Start < -24*time.Hour || spec.Start > 24*time.Hour || spec.Duration <= 0 || spec.Duration > 24*time.Hour || len(targets) == 0 || len(targets) > 100000 :: speed zero makes every projected travel either nonfinite or NaN; the mandatory later finite(seconds) guard rejects every target, so no plan is accepted
firefront/front.go New: !pointOK(spec.Origin) || !pointOK(spec.Direction) || spec.Direction.Y != 0 || !(spec.Direction.Len() > 0) || !finite(spec.Direction.Len()) || !(spec.Speed > 0) || !finite(spec.Speed) || !(spec.Cell > 0) || !finite(spec.Cell) || spec.Start < -24*time.Hour || spec.Start > 24*time.Hour || spec.Duration <= 0 || spec.Duration > 24*time.Hour || len(targets) == 0 || len(targets) > 100000 => !pointOK(spec.Origin) || !pointOK(spec.Direction) || spec.Direction.Y != 0 || !(spec.Direction.Len() > 0) || !finite(spec.Direction.Len()) || !(spec.Speed > 0) || !finite(spec.Speed) || !(spec.Cell >= 0) || !finite(spec.Cell) || spec.Start < -24*time.Hour || spec.Start > 24*time.Hour || spec.Duration <= 0 || spec.Duration > 24*time.Hour || len(targets) == 0 || len(targets) > 100000 :: cell zero makes at least one tile quotient nonfinite or NaN; the mandatory later finite(x)/finite(z) guards reject every target
firefront/front.go New: return keys[i].x < keys[j].x => return keys[i].x <= keys[j].x :: this branch is entered only when x keys differ, so equality is unreachable
firefront/front.go New: return keys[i].z < keys[j].z => return keys[i].z <= keys[j].z :: the tile map contains distinct keys; this branch already has equal x, so compared z keys cannot be equal
firefront/front.go New: low, high := group[0].Start, group[0].Start+group[0].Duration => low, high := group[0].Start, group[0].Start-group[0].Duration :: the following loop includes group[0] and takes max with its true end; positive durations restore the identical high bound before any use
firefront/front.go New: return edges[i].at < edges[j].at => return edges[i].at <= edges[j].at :: this branch is entered only when times differ, so equality is unreachable
firefront/front.go New: return edges[i].delta < edges[j].delta => return edges[i].delta <= edges[j].delta :: only equal-time equal-delta entries change order; those entries have identical time and count effects in the sweep
firefront/front.go PeakTargets: end > time.Duration(math.MaxInt64)-tail => end >= time.Duration(math.MaxInt64)-tail :: at equality both saturation and end+tail give MaxInt64 exactly; all other inputs take the same branch
firefront/front.go PeakTargets: return edges[i].at < edges[j].at => return edges[i].at <= edges[j].at :: this branch is entered only when times differ, so equality is unreachable
firefront/front.go PeakTargets: return edges[i].delta < edges[j].delta => return edges[i].delta <= edges[j].delta :: only equal-time equal-delta entries change order; those entries have identical time and count effects in the sweep
flame/composition.go NewComposition: !sane(wavelength) || !(line.Radiance >= 0) || math.IsInf(line.Radiance, 0) || strings.TrimSpace(line.Species) == "" || strings.TrimSpace(line.Source) == "" || (line.Convention != "air" && line.Convention != "vacuum") => !sane(wavelength) || !(line.Radiance >= 0) || math.IsInf(line.Radiance, 1) || strings.TrimSpace(line.Species) == "" || strings.TrimSpace(line.Source) == "" || (line.Convention != "air" && line.Convention != "vacuum") :: !(Radiance>=0) already rejects negative infinity; both IsInf variants still reject positive infinity
flame/strength.go WithStrengths: math.IsNaN(v) || math.IsInf(v, 0) || v < 0 || v > 1 => math.IsNaN(v) || math.IsInf(v, 1) || v < 0 || v > 1 :: the independent v<0 condition already rejects negative infinity; both IsInf variants still reject positive infinity
manufacture/burner.go Burn: body, err := makeBurningField(spec, 1) => body, err := makeBurningField(spec, 2) :: this temporary field supplies only geometric bounds and validation; both finite positive exposures are valid and affect only the discarded palette, while Place rebuilds with the caller exposure
manufacture/burner.go burnPlacement: return math.Abs(x.Len()-1) < 1e-9 && math.Abs(y.Len()-1) < 1e-9 && math.Abs(z.Len()-1) < 1e-9 && math.Abs(x.Dot(y)) < 1e-9 && math.Abs(x.Dot(z)) < 1e-9 && math.Abs(y.Dot(z)) < 1e-9 && x.Cross(y).Dot(z) > 0 => return math.Abs(x.Len()-1) <= 1e-9 && math.Abs(y.Len()-1) < 1e-9 && math.Abs(z.Len()-1) < 1e-9 && math.Abs(x.Dot(y)) < 1e-9 && math.Abs(x.Dot(z)) < 1e-9 && math.Abs(y.Dot(z)) < 1e-9 && x.Cross(y).Dot(z) > 0 :: binary64 Len minus one near unity is an exact multiple of 2^-53; binary64(1e-9) is not on that lattice, so equality is unreachable (doc/mutation-equivalence.md)
manufacture/burner.go burnPlacement: return math.Abs(x.Len()-1) < 1e-9 && math.Abs(y.Len()-1) < 1e-9 && math.Abs(z.Len()-1) < 1e-9 && math.Abs(x.Dot(y)) < 1e-9 && math.Abs(x.Dot(z)) < 1e-9 && math.Abs(y.Dot(z)) < 1e-9 && x.Cross(y).Dot(z) > 0 => return math.Abs(x.Len()-1) < 1e-9 && math.Abs(y.Len()-1) <= 1e-9 && math.Abs(z.Len()-1) < 1e-9 && math.Abs(x.Dot(y)) < 1e-9 && math.Abs(x.Dot(z)) < 1e-9 && math.Abs(y.Dot(z)) < 1e-9 && x.Cross(y).Dot(z) > 0 :: binary64 Len minus one near unity is an exact multiple of 2^-53; binary64(1e-9) is not on that lattice, so equality is unreachable (doc/mutation-equivalence.md)
manufacture/burner.go burnPlacement: return math.Abs(x.Len()-1) < 1e-9 && math.Abs(y.Len()-1) < 1e-9 && math.Abs(z.Len()-1) < 1e-9 && math.Abs(x.Dot(y)) < 1e-9 && math.Abs(x.Dot(z)) < 1e-9 && math.Abs(y.Dot(z)) < 1e-9 && x.Cross(y).Dot(z) > 0 => return math.Abs(x.Len()-1) < 1e-9 && math.Abs(y.Len()-1) < 1e-9 && math.Abs(z.Len()-1) <= 1e-9 && math.Abs(x.Dot(y)) < 1e-9 && math.Abs(x.Dot(z)) < 1e-9 && math.Abs(y.Dot(z)) < 1e-9 && x.Cross(y).Dot(z) > 0 :: binary64 Len minus one near unity is an exact multiple of 2^-53; binary64(1e-9) is not on that lattice, so equality is unreachable (doc/mutation-equivalence.md)
manufacture/burner.go burnPlacement: return math.Abs(x.Len()-1) < 1e-9 && math.Abs(y.Len()-1) < 1e-9 && math.Abs(z.Len()-1) < 1e-9 && math.Abs(x.Dot(y)) < 1e-9 && math.Abs(x.Dot(z)) < 1e-9 && math.Abs(y.Dot(z)) < 1e-9 && x.Cross(y).Dot(z) > 0 => return math.Abs(x.Len()-1) < 1e-9 && math.Abs(y.Len()-1) < 1e-9 && math.Abs(z.Len()-1) < 1e-9 && math.Abs(x.Dot(y)) < 1e-9 && math.Abs(x.Dot(z)) < 1e-9 && math.Abs(y.Dot(z)) < 1e-9 && x.Cross(y).Dot(z) >= 0 :: the preceding unit and orthogonality checks bound the Gram matrix away from singularity; the determinant cannot be zero (doc/mutation-equivalence.md)

# Duplicate validation and delegated empty quadrature.
embers/embers.go At: if when < 0 { return nil } => if when < 0 { } :: for a negative clock and positive rate the last birth index is negative, or zero after underflow; no nonnegative ID has nonnegative age, so the result remains nil
firefront/front.go New: !pointOK(spec.Origin) || !pointOK(spec.Direction) || spec.Direction.Y != 0 || !(spec.Direction.Len() > 0) || !finite(spec.Direction.Len()) || !(spec.Speed > 0) || !finite(spec.Speed) || !(spec.Cell > 0) || !finite(spec.Cell) || spec.Start < -24*time.Hour || spec.Start > 24*time.Hour || spec.Duration <= 0 || spec.Duration > 24*time.Hour || len(targets) == 0 || len(targets) > 100000 => !pointOK(spec.Origin) && !pointOK(spec.Direction) || spec.Direction.Y != 0 || !(spec.Direction.Len() > 0) || !finite(spec.Direction.Len()) || !(spec.Speed > 0) || !finite(spec.Speed) || !(spec.Cell > 0) || !finite(spec.Cell) || spec.Start < -24*time.Hour || spec.Start > 24*time.Hour || spec.Duration <= 0 || spec.Duration > 24*time.Hour || len(targets) == 0 || len(targets) > 100000 :: a nonfinite direction still fails its length check; a nonfinite origin makes a tile quotient or the projected travel nonfinite (including Inf*0), which the mandatory conversion guard rejects
firefront/front.go New: if !pointOK(target.At) { return nil, refuse } => if !pointOK(target.At) { } :: a nonfinite target makes a tile quotient or projected travel nonfinite, including a nonfinite vertical component times the horizontal direction zero; the mandatory conversion guard rejects it
flame/body.go bodyWithPalette: !sane(fire.Radius) || !sane(fire.Height) || !(fire.Absorption >= 0) || math.IsInf(fire.Absorption, 0) || !sane(hot) || !sane(edge) || edge > hot || !sane(exposure) || !(fire.Intermittency >= 0 && fire.Intermittency < 1) => !sane(fire.Radius) || !sane(fire.Height) || !(fire.Absorption >= 0) || math.IsInf(fire.Absorption, 1) || !sane(hot) || !sane(edge) || edge > hot || !sane(exposure) || !(fire.Intermittency >= 0 && fire.Intermittency < 1) :: !(Absorption>=0) independently rejects negative infinity; both IsInf variants still reject positive infinity
flame/field.go Sources: if cells < 1 { return nil } => if cells < 1 { } :: every delegated Body.Sources call already returns nil for a nonpositive resolution; appending those empty samples leaves the result nil

# Private empty state and allocation-only choices.
flame/field.go At: if !active { continue } => if !active { } :: bodyAt returns a zero Body for an inactive patch; its zero height makes inside return zero depth for every point, and the mandatory density-zero guard still discards it before reading its palette
manufacture/complexity.go individualFoliage: parts := make([]part, 0, len(made.parts)+leaves) => parts := make([]part, 0, len(made.parts)-leaves) :: leaves is at most len(parts), so both capacities are nonnegative; only the append allocation hint changes, with identical element order and values
manufacture/good.go gather: next := slot(0) => next := slot(1) :: all gathered material, part and group keys shift together; slots are private int identifiers and their sorted order, public Things, Bounds and Lights stay the same; no consumer applies foliage roles to gathered goods
manufacture/good.go placed: len(made.groups) > 0 => len(made.groups) >= 0 :: for no groups this only replaces a nil or empty private map with an empty private map; all public behavior ranges or reads its entries

# Finite recipe domains and exact geometric equivalences.
manufacture/good.go slots: return slots[one] < slots[other] => return slots[one] <= slots[other] :: slots contains each private material key once; sort compares distinct elements, so key equality cannot occur
manufacture/grow.go fernGrowth: frond, frondError := stemCarrying(1, 0, []sleeve{stalk}, pairs, 1, 0, []sleeve{blade}) => frond, frondError := stemCarrying(1, 1, []sleeve{stalk}, pairs, 1, 0, []sleeve{blade}) :: the changed droop belongs to a one-piece limb; runs applies droop only when placing a second or later piece, and both values pass validation
manufacture/grow.go fernGrowth: frond, frondError := stemCarrying(1, 0, []sleeve{stalk}, pairs, 1, 0, []sleeve{blade}) => frond, frondError := stemCarrying(1, 0, []sleeve{stalk}, pairs, 1, 1, []sleeve{blade}) :: the changed droop belongs to a one-piece limb; runs applies droop only when placing a second or later piece, and both values pass validation
manufacture/grow.go fernGrowth: crown, crownError := newLimb(1, crownSpan, 0, stub) => crown, crownError := newLimb(1, crownSpan, 1, stub) :: the changed droop belongs to a one-piece limb; runs applies droop only when placing a second or later piece, and both values pass validation
manufacture/home.go made: if len(glass.blocks) == 0 { continue } => if len(glass.blocks) == 0 { } :: an empty pane contributes no blocks, slots or lights when gathered; retaining its empty good changes no exported geometry or emission
manufacture/kinds.go scaffold: sprays := 0 => sprays := 1 :: without shoots the architecture does not read sprays; with shoots the seeded count overwrites this initial value before use
manufacture/kinds.go scaffold: err == nil && row.flare > 0 => err == nil && row.flare > 1 :: public conifer rows use flare zero, 1.5 or 1.6 only; both guards select the same rows
manufacture/kinds.go made: grown, growthError := stemCarrying(1, 0, []sleeve{trunk}, along, 1, 0, []sleeve{stub}) => grown, growthError := stemCarrying(1, 1, []sleeve{trunk}, along, 1, 0, []sleeve{stub}) :: the changed droop belongs to a one-piece limb; runs applies droop only when placing a second or later piece, and both values pass validation
manufacture/kinds.go made: grown, growthError := stemCarrying(1, 0, []sleeve{trunk}, along, 1, 0, []sleeve{stub}) => grown, growthError := stemCarrying(1, 0, []sleeve{trunk}, along, 1, 1, []sleeve{stub}) :: the changed droop belongs to a one-piece limb; runs applies droop only when placing a second or later piece, and both values pass validation
manufacture/needled_shoot.go planShoot: childLength < 2*needleSpacing(style) => childLength <= 2*needleSpacing(style) :: the only production caller has twenty fixed prototype configurations, with no child exactly at the cutoff; see retained exhaustive producer and prototype-domain-provenance.txt
manufacture/needled_shoot.go planShoot: grow(shootAxis{direction: maths.YAxis, normal: maths.ZAxis, length: length, radius: shootValue("shoot-base-radius") * length / shootValue("shoot-cell-length"), parent: -1}) => grow(shootAxis{direction: maths.YAxis, normal: maths.ZAxis, length: length, radius: shootValue("shoot-base-radius") * length / shootValue("shoot-cell-length"), parent: +1}) :: the root parent is private metadata never consumed in production; only nonroot parent links describe attachments, and geometry is unchanged
manufacture/needled_shoot.go planShoot: grow(shootAxis{direction: maths.YAxis, normal: maths.ZAxis, length: length, radius: shootValue("shoot-base-radius") * length / shootValue("shoot-cell-length"), parent: -1}) => grow(shootAxis{direction: maths.YAxis, normal: maths.ZAxis, length: length, radius: shootValue("shoot-base-radius") * length / shootValue("shoot-cell-length"), parent: -2}) :: the root parent is private metadata never consumed in production; only nonroot parent links describe attachments, and geometry is unchanged
manufacture/needled_shoot.go addNeedles: count := max(1, int(axis.length/needleSpacing(style))) => count := max(2, int(axis.length/needleSpacing(style))) :: every axis in the twenty production prototype plans has at least two needles; see the exhaustive 1240-axis producer and prototype-domain-provenance.txt
manufacture/needled_shoot.go withFoliageGroups: groups := make(map[slot]*shape.MeshGroup, 2) => groups := make(map[slot]*shape.MeshGroup, 3) :: only the private map allocation hint changes; both maps receive the same wood and leaf entries
scene/medium/grove.go NewGrove: grove := &Grove{weather: weather, ground: ground, cell: weather.Depth, canopies: map[[2]int][]Canopy{}, box: maths.Box{ Min: maths.V(math.Inf(1), math.Inf(1), math.Inf(1)), Max: maths.V(math.Inf(-1), math.Inf(-1), math.Inf(-1))}} => grove := &Grove{weather: weather, ground: ground, cell: weather.Depth, canopies: map[[2]int][]Canopy{}, box: maths.Box{ Min: maths.V(math.Inf(2), math.Inf(1), math.Inf(1)), Max: maths.V(math.Inf(-1), math.Inf(-1), math.Inf(-1))}} :: math.Inf selects only the argument sign; one and two yield the same infinity, as do minus one and minus two
