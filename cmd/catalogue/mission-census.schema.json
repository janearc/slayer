{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "complete", "reviewed-on", "missions"],
  "properties": {
    "scope": {"type": "string", "minLength": 1},
    "complete": {"const": false},
    "reviewed-on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "missions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "name", "priority", "flight", "references", "notes"],
        "properties": {
          "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 1, "maximum": 3},
          "flight": {"enum": ["launched", "unlaunched"]},
          "notes": {"type": "string"},
          "references": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["title", "url"],
              "properties": {
                "title": {"type": "string", "minLength": 1},
                "url": {"type": "string", "pattern": "^https://[^ /]+/"}
              }
            }
          }
        }
      }
    }
  }
}
