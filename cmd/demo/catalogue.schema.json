{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "preview": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3840
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2160
        },
        "rays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "cells": {
          "type": "string",
          "minLength": 1
        },
        "pixel-aspect": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "shutdown-grace": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "limits": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3840
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2160
            },
            "rays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "required": [
            "width",
            "height",
            "rays"
          ],
          "additionalProperties": false
        },
        "sample-budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8294400
        }
      },
      "required": [
        "width",
        "height",
        "rays",
        "cells",
        "pixel-aspect",
        "shutdown-grace",
        "limits",
        "sample-budget"
      ],
      "additionalProperties": false
    },
    "demos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "command": {
            "enum": [
              "orbital",
              "swarm",
              "ring",
              "hillside",
              "moonrise",
              "house"
            ]
          },
          "about": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "raw-preview": {
            "type": "boolean"
          },
          "scene-sized": {
            "type": "boolean"
          },
          "plan": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "command",
          "about",
          "arguments"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "preview",
    "demos"
  ],
  "additionalProperties": false
}
