@@ -0,0 +1,29 @@
+//go:build darwin
+
+package platform
+
+import (
+	"testing"
+
+	"github.com/gogpu/gogpu/internal/platform/eventqueue"
+	"github.com/gogpu/gpucontext"
+)
+
+func TestCommandShortcutDoesNotProduceText(t *testing.T) {
+	w := &darwinWindow{events: eventqueue.New[Event](eventqueue.DefaultCapacity)}
+	w.modifiers = gpucontext.ModSuper
+	w.dispatchCharacters([]byte("o\x00"))
+	if e, ok := w.events.Pop(); ok {
+		t.Fatalf("command shortcut produced text: %+v", e)
+	}
+	w.modifiers = gpucontext.ModAlt
+	w.dispatchCharacters([]byte("ø\x00"))
+	if e, ok := w.events.Pop(); !ok || e.Type != EventChar || e.Char != 'ø' {
+		t.Fatalf("option text lost: %+v, present %v", e, ok)
+	}
+	w.modifiers = 0
+	w.dispatchCharacters([]byte("o\x00"))
+	if e, ok := w.events.Pop(); !ok || e.Type != EventChar || e.Char != 'o' {
+		t.Fatalf("ordinary text lost: %+v, present %v", e, ok)
+	}
+}
