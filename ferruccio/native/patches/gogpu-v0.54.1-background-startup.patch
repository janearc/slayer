--- /dev/null
+++ b/internal/platform/darwin/application_background_test.go
@@ -0,0 +1,22 @@
+//go:build darwin
+
+package darwin
+
+import "testing"
+
+// TestActivationPolicyFor checks the policy chosen for each startup mode.
+// Background must allow windows (accessory); Prohibited must never be used.
+func TestActivationPolicyFor(t *testing.T) {
+	// Values are Apple's NSApplicationActivationPolicy constants.
+	const regular, accessory, prohibited = 0, 1, 2
+	if got := activationPolicyFor(false); got != regular {
+		t.Fatalf("background off: policy %d, want regular %d", got, regular)
+	}
+	got := activationPolicyFor(true)
+	if got != accessory {
+		t.Fatalf("background on: policy %d, want accessory %d", got, accessory)
+	}
+	if got == prohibited {
+		t.Fatal("background on must not use prohibited")
+	}
+}
