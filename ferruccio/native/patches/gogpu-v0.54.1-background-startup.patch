@@ -0,0 +1,35 @@
+package gogpu
+
+import (
+	"testing"
+
+	"github.com/gogpu/gogpu/internal/platform"
+)
+
+// showCountingWindow counts the native Show and Hide calls it receives.
+type showCountingWindow struct {
+	platform.PlatformWindow
+	shows, hides int
+}
+
+func (window *showCountingWindow) Show() { window.shows++ }
+func (window *showCountingWindow) Hide() { window.hides++ }
+
+// TestStartHiddenWindowRecordsVisibility checks that a window started hidden
+// reports not visible but is still drawn, and that a later Show reaches the
+// native window and makes the record match. Hide stops drawing.
+func TestStartHiddenWindowRecordsVisibility(t *testing.T) {
+	native := &showCountingWindow{}
+	window := &Window{platWindow: native, startHidden: true}
+	if window.Visible() || !window.renders() {
+		t.Fatalf("started hidden: visible %v renders %v", window.Visible(), window.renders())
+	}
+	window.Show()
+	if native.shows != 1 || !window.Visible() || !window.renders() {
+		t.Fatalf("after Show: native %d visible %v", native.shows, window.Visible())
+	}
+	window.Hide()
+	if native.hides != 1 || window.Visible() || window.renders() {
+		t.Fatalf("after Hide: native %d visible %v", native.hides, window.Visible())
+	}
+}
