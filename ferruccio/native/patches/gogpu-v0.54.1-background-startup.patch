diff --git a/background_config_test.go b/background_config_test.go
new file mode 100644
index 0000000..04bc694
--- /dev/null
+++ b/background_config_test.go
@@ -0,0 +1,87 @@
+package gogpu
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/gogpu/gogpu/internal/platform"
+)
+
+// TestBackgroundStartupIsExplicit preserves normal defaults and value-builder semantics.
+func TestBackgroundStartupIsExplicit(t *testing.T) {
+	original := DefaultConfig()
+	if original.Background {
+		t.Fatal("normal startup defaults to background")
+	}
+	background := original.WithBackground(true)
+	if !background.Background || original.Background {
+		t.Fatal("background builder did not preserve original config")
+	}
+	if background.WithBackground(false).Background {
+		t.Fatal("background cannot be disabled")
+	}
+}
+
+// backgroundStartupManager stops before native window creation while observing
+// the actual application's ordering and window configuration boundary.
+type backgroundStartupManager struct {
+	platform.PlatformManager
+	t                                            *testing.T
+	configured, background, initialized, created bool
+	windowBackground                             bool
+	stop                                         error
+}
+
+func (manager *backgroundStartupManager) SetBackground(background bool) {
+	if manager.initialized {
+		manager.t.Fatal("background policy arrived after platform initialization")
+	}
+	manager.configured, manager.background = true, background
+}
+
+func (manager *backgroundStartupManager) Init() error {
+	if !manager.configured {
+		manager.t.Fatal("platform initialized before background policy was configured")
+	}
+	manager.initialized = true
+	return nil
+}
+
+func (manager *backgroundStartupManager) CreateWindow(config platform.Config) (platform.PlatformWindow, error) {
+	if !manager.initialized {
+		manager.t.Fatal("window creation preceded platform initialization")
+	}
+	manager.created, manager.windowBackground = true, config.Background
+	return nil, manager.stop
+}
+
+// TestBackgroundPolicyPrecedesPlatformInit verifies the real startup boundary
+// without constructing a native window, surface or graphics device.
+func TestBackgroundPolicyPrecedesPlatformInit(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		config Config
+	}{
+		{name: "normal default", config: DefaultConfig()},
+		{name: "background", config: DefaultConfig().WithBackground(true)},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			stop := errors.New("stop before native window creation")
+			manager := &backgroundStartupManager{t: t, stop: stop}
+			original := newPlatformManagerFn
+			newPlatformManagerFn = func() platform.PlatformManager { return manager }
+			t.Cleanup(func() { newPlatformManagerFn = original })
+			application := &App{config: test.config}
+			window, err := application.initPlatform()
+			if !errors.Is(err, stop) || window != nil {
+				t.Fatalf("startup did not stop at fake window boundary: %v, %v", window, err)
+			}
+			if !manager.configured || !manager.initialized || !manager.created {
+				t.Fatalf("incomplete startup: %+v", manager)
+			}
+			if manager.background != test.config.Background || manager.windowBackground != test.config.Background {
+				t.Fatalf("background policy lost: app=%v platform=%v window=%v", test.config.Background, manager.background, manager.windowBackground)
+			}
+		})
+	}
+}
