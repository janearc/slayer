--- /dev/null
+++ b/internal/platform/platform_darwin_background_test.go
@@ -0,0 +1,33 @@
+//go:build darwin
+
+package platform
+
+import "testing"
+
+// TestStartHiddenSkipsOnlyStartupShow checks that the start-up show is
+// skipped and every later show reaches the native window.
+func TestStartHiddenSkipsOnlyStartupShow(t *testing.T) {
+	shown := 0
+	show := func() { shown++ }
+
+	startHidden := true
+	showUnlessStartHidden(&startHidden, show) // start-up show
+	if shown != 0 || startHidden {
+		t.Fatalf("start-up show: native shows %d, startHidden %v", shown, startHidden)
+	}
+	showUnlessStartHidden(&startHidden, show) // later public Show
+	showUnlessStartHidden(&startHidden, show)
+	if shown != 2 {
+		t.Fatalf("later shows reached native %d times, want 2", shown)
+	}
+}
+
+// TestNormalStartupShowsNative checks the default: no show is skipped.
+func TestNormalStartupShowsNative(t *testing.T) {
+	shown := 0
+	startHidden := false
+	showUnlessStartHidden(&startHidden, func() { shown++ })
+	if shown != 1 {
+		t.Fatalf("normal start-up reached native %d times, want 1", shown)
+	}
+}
