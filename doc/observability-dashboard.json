{
  "title": "Slayer render observability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [{"name": "datasource", "type": "datasource", "query": "prometheus", "label": "Prometheus"}]},
  "panels": [
    {"id": 1, "title": "Device-wide GPU utilization", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "targets": [{"expr": "azazel_gpu_device_utilization_percent and azazel_gpu_device_utilization_available == 1", "legendFormat": "{{instance}}", "refId": "A"}]},
    {"id": 2, "title": "Swap used", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "targets": [{"expr": "azazel_host_swap_used_bytes and azazel_host_swap_available == 1", "legendFormat": "{{instance}}", "refId": "A"}]},
    {"id": 3, "title": "Render process-group memory", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "targets": [{"expr": "azazel_render_group_resident_bytes and azazel_render_group_resident_known == 1", "legendFormat": "current RSS", "refId": "A"}, {"expr": "azazel_running_peak_resident_bytes_sum", "legendFormat": "sum of per-job peaks", "refId": "B"}, {"expr": "azazel_render_group_footprint_bytes and azazel_render_group_footprint_known == 1", "legendFormat": "current physical footprint sum", "refId": "C"}]},
    {"id": 4, "title": "Queue and pressure", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"expr": "azazel_jobs_queued", "legendFormat": "queued", "refId": "A"}, {"expr": "azazel_jobs_running", "legendFormat": "running", "refId": "B"}, {"expr": "azazel_host_memory_pressure_level and azazel_host_memory_pressure_available == 1", "legendFormat": "pressure level", "refId": "C"}]},
    {"id": 5, "title": "Mean GPU glimpse stage time", "type": "timeseries", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "targets": [{"expr": "rate(slayer_gpu_acceleration_wall_seconds_sum[5m]) / rate(slayer_gpu_acceleration_wall_seconds_count[5m])", "legendFormat": "acceleration wall", "refId": "A"}, {"expr": "rate(slayer_gpu_trace_device_seconds_sum[5m]) / rate(slayer_gpu_trace_device_seconds_count[5m])", "legendFormat": "trace device", "refId": "B"}]},
    {"id": 6, "title": "Go heap, RSS and footprint", "type": "timeseries", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "targets": [{"expr": "go_memstats_heap_alloc_bytes", "legendFormat": "heap {{job}} {{instance}}", "refId": "A"}, {"expr": "process_resident_memory_bytes and process_resident_memory_available == 1", "legendFormat": "RSS {{job}} {{instance}}", "refId": "B"}, {"expr": "process_physical_footprint_bytes and process_physical_footprint_available == 1", "legendFormat": "footprint {{job}} {{instance}}", "refId": "C"}, {"expr": "process_peak_physical_footprint_bytes and process_peak_physical_footprint_available == 1", "legendFormat": "peak footprint {{job}} {{instance}}", "refId": "D"}]},
    {"id": 7, "title": "Metal device allocation after glimpse", "type": "timeseries", "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "targets": [{"expr": "slayer_gpu_after_glimpse_device_allocated_bytes and slayer_gpu_after_glimpse_device_memory_available == 1", "legendFormat": "device allocation snapshot", "refId": "A"}, {"expr": "slayer_gpu_device_recommended_working_set_bytes and slayer_gpu_after_glimpse_device_memory_available == 1", "legendFormat": "recommended working set", "refId": "B"}]},
    {"id": 8, "title": "Process CPU cores", "type": "timeseries", "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "targets": [{"expr": "rate(process_cpu_seconds_total[5m]) and process_cpu_available == 1", "legendFormat": "{{job}} {{instance}}", "refId": "A"}]},
    {"id": 9, "title": "Host CPU utilization", "type": "timeseries", "gridPos": {"x": 0, "y": 32, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "targets": [{"expr": "azazel_host_cpu_busy_percent and azazel_host_cpu_busy_known == 1", "legendFormat": "{{instance}}", "refId": "A"}]},
    {"id": 10, "title": "Host VM page states", "description": "Free includes speculative pages and is not available memory. Compressor is physical compressed-pager storage. These categories can overlap; do not sum them.", "type": "timeseries", "gridPos": {"x": 12, "y": 32, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "targets": [{"expr": "azazel_host_vm_free_bytes and azazel_host_vm_page_states_available == 1", "legendFormat": "free (includes speculative)", "refId": "A"}, {"expr": "azazel_host_vm_active_bytes and azazel_host_vm_page_states_available == 1", "legendFormat": "active", "refId": "B"}, {"expr": "azazel_host_vm_inactive_bytes and azazel_host_vm_page_states_available == 1", "legendFormat": "inactive", "refId": "C"}, {"expr": "azazel_host_vm_wired_bytes and azazel_host_vm_page_states_available == 1", "legendFormat": "wired", "refId": "D"}, {"expr": "azazel_host_vm_compressor_resident_bytes and azazel_host_vm_compressor_available == 1", "legendFormat": "compressor", "refId": "E"}, {"expr": "azazel_host_physical_memory_total_bytes and azazel_host_physical_memory_total_available == 1", "legendFormat": "physical total", "refId": "F"}]}
  ]
}
