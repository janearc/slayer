{
	// @analog-drive exactly, the voicing the owner kept, with its master
	// lowered from 0.36 to 0.25 and nothing else changed: a line of
	// sixteenths with ff accents over a rolling bass peaks at 1.15
	// through the built-in and is refused. for glass-rush.
	"name": "drive-low",
	"machine": "studio",
	"master": 0.25,
	"reverb": {"size": 0.3, "decay": 0.9, "damping": 0.4, "level": 0.3},
	"channels": [
		{"kind": "analog", "role": "lead", "volume": 0.7, "place": -0.1,
		 "send": {"reverb": 0.25},
		 "envelope": {"attack": 0.003, "decay": 0.5, "sustain": 0.6,
		              "release": 0.18},
		 "vibrato": {"rate": 5.5, "depth": 8, "delay": 0.2},
		 "analog": {"oscillators": [{"shape": "saw"},
		                            {"shape": "saw", "detune": 11}],
		            "drive": 0.45,
		            "filter": {"cutoff": 1800, "resonance": 0.55,
		                       "follow": 0.7, "amount": 2.5,
		                       "envelope": {"attack": 0.002,
		                                    "decay": 0.35,
		                                    "sustain": 0.25,
		                                    "release": 0.2}}}},
		{"kind": "analog", "role": "pad", "volume": 0.5, "place": 0.4,
		 "send": {"reverb": 0.3},
		 "envelope": {"attack": 0.004, "decay": 0.4, "sustain": 0.4,
		              "release": 0.25},
		 "analog": {"oscillators": [{"shape": "square", "width": 0.25},
		                            {"shape": "saw", "detune": -8}],
		            "filter": {"cutoff": 2200, "resonance": 0.3,
		                       "follow": 0.5}}},
		{"kind": "analog", "role": "bass", "volume": 0.45,
		 "envelope": {"attack": 0.002, "decay": 0.3, "sustain": 0.7,
		              "release": 0.1},
		 "analog": {"oscillators": [{"shape": "square"},
		                            {"shape": "saw", "octave": -1,
		                             "level": 0.5}],
		            "drive": 0.3,
		            "filter": {"cutoff": 900, "resonance": 0.35,
		                       "follow": 0.5, "amount": 2,
		                       "envelope": {"attack": 0, "decay": 0.18,
		                                    "sustain": 0.2,
		                                    "release": 0.1}}}},
		{"kind": "drum", "role": "perc", "volume": 0.9,
		 "send": {"reverb": 0.15},
		 "drums": {
			"k": {"tone": 55, "sweep": 36, "fall": 0.035, "decay": 0.28,
			      "click": 0.6},
			"s": {"tone": 200, "sweep": 6, "fall": 0.03, "decay": 0.11,
			      "click": 0.4, "noise": 0.7, "noise_decay": 0.17,
			      "colour": 1500},
			"h": {"noise": 0.45, "noise_decay": 0.035, "colour": 8000},
			"t": {"tone": 130, "sweep": 12, "fall": 0.06, "decay": 0.22,
			      "click": 0.3},
			"o": {"noise": 0.45, "noise_decay": 0.28, "colour": 8000},
			"b": {"tone": 800, "decay": 0.12, "click": 0.5}
		 }}
	]
}
