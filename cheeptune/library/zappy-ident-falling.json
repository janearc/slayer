{
	// zappy's ident, the falling form. 126 a minute, two bars, 3.81 s.
	//
	// the plan. the rising motif (zappy-ident) turned over: a5 e5 d5 a4,
	// then d5. down a fourth, down a step, down a fourth, and up a fourth
	// to the home note. the same rhythm, short short long long | held.
	// it starts at its loudest and eases as it falls, and it ends on d,
	// the key's own note, so it closes like a full stop where the rising
	// form ends on a question.
	//
	// bar 1: a clock's tick on each beat, the four falling notes on
	//        beats two to four, plucked.
	// bar 2: d5 on the downbeat with the same large floor as the rising
	//        form: bb1 in the bass, (bb2 d4) under it, one deep drum. with
	//        d on top the chord is a plain wide b flat, which is settled:
	//        the floor agrees with the tune's last note.
	//
	// what differs for the ear: rising asks and is left unsure; falling
	// states and is confirmed. everything else is the same on purpose.
	"name": "zappy-ident-falling",
	"tempo": 126,
	"meter": 4,
	"loop": false,
	"parts": [
		{"role": "lead", "bars": [
			"- a5:1/2@f e5:1/2 d5 a4@mp",
			"d5:4"
		]},
		{"role": "pad", "bars": [
			"-:4",
			"(bb2 d4):4"
		]},
		{"role": "bass", "bars": [
			"-:4",
			"bb1:4@f"
		]},
		{"role": "perc", "bars": [
			"h@mp h@p h@p h@p",
			"k -:3"
		]}
	]
}
