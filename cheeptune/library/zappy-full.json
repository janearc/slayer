{
	// zappy at full scale: the voice of the big piece, made from the
	// driven saw the owner kept. the tune is @analog-drive's lead exactly
	// (two saws, driven, through a filter that rings) with the same sound
	// an octave lower laid under it, slower to open, so a tune written
	// in the middle has weight below it: low brass, as near as two saws
	// get. the chords are a section of the same saws. the bass is
	// @analog-drive's square. the drums are @analog-drive's kick, snare
	// and hat; o is a crash of bright noise that rings on, t a low tom
	// that booms, b a small metal accent. nothing struck,
	// no bells: every sound's overtones are in tune with its note.
	// picked by the composer on 2026-11-12 with nobody listening.
	"name": "zappy-full",
	"machine": "studio",
	"master": 0.19,
	"reverb": {"size": 0.6, "decay": 2.2, "damping": 0.4, "level": 0.35},
	"channels": [
		{"kind": "analog", "role": "lead", "volume": 0.55, "place": -0.1,
		 "send": {"reverb": 0.25},
		 "envelope": {"attack": 0.003, "decay": 0.5, "sustain": 0.6,
		              "release": 0.18},
		 "vibrato": {"rate": 5.5, "depth": 8, "delay": 0.2},
		 "analog": {"oscillators": [{"shape": "saw"},
		                            {"shape": "saw", "detune": 11}],
		            "drive": 0.45,
		            "filter": {"cutoff": 1800, "resonance": 0.55,
		                       "follow": 0.7, "amount": 2.5,
		                       "envelope": {"attack": 0.002,
		                                    "decay": 0.35,
		                                    "sustain": 0.25,
		                                    "release": 0.2}}}},
		{"kind": "analog", "role": "lead", "volume": 0.32, "place": 0.15,
		 "send": {"reverb": 0.3},
		 "envelope": {"attack": 0.03, "decay": 0.6, "sustain": 0.7,
		              "release": 0.25},
		 "analog": {"oscillators": [{"shape": "saw", "octave": -1},
		                            {"shape": "saw", "octave": -1,
		                             "detune": 7}],
		            "drive": 0.2,
		            "filter": {"cutoff": 900, "resonance": 0.2,
		                       "follow": 0.5, "amount": 2,
		                       "envelope": {"attack": 0.05, "decay": 0.5,
		                                    "sustain": 0.4,
		                                    "release": 0.25}}}},
		{"kind": "analog", "role": "pad", "volume": 0.55, "place": 0.35,
		 "send": {"reverb": 0.4},
		 "envelope": {"attack": 0.05, "decay": 0.8, "sustain": 0.75,
		              "release": 0.4},
		 "analog": {"oscillators": [{"shape": "saw", "detune": -6},
		                            {"shape": "saw", "detune": 6}],
		            "filter": {"cutoff": 900, "resonance": 0.15,
		                       "follow": 0.5, "amount": 1.8,
		                       "envelope": {"attack": 0.06, "decay": 0.7,
		                                    "sustain": 0.4,
		                                    "release": 0.4}}}},
		{"kind": "analog", "role": "bass", "volume": 0.45,
		 "envelope": {"attack": 0.002, "decay": 0.3, "sustain": 0.7,
		              "release": 0.1},
		 "analog": {"oscillators": [{"shape": "square"},
		                            {"shape": "saw", "octave": -1,
		                             "level": 0.5}],
		            "drive": 0.3,
		            "filter": {"cutoff": 900, "resonance": 0.35,
		                       "follow": 0.5, "amount": 2,
		                       "envelope": {"attack": 0, "decay": 0.18,
		                                    "sustain": 0.2,
		                                    "release": 0.1}}}},
		{"kind": "drum", "role": "perc", "volume": 1,
		 "send": {"reverb": 0.2},
		 "drums": {
			"k": {"tone": 55, "sweep": 36, "fall": 0.035, "decay": 0.28,
			      "click": 0.6},
			"s": {"tone": 200, "sweep": 6, "fall": 0.03, "decay": 0.11,
			      "click": 0.4, "noise": 0.7, "noise_decay": 0.17,
			      "colour": 1500},
			"h": {"noise": 0.45, "noise_decay": 0.035, "colour": 8000},
			"o": {"noise": 0.6, "noise_decay": 1.2, "colour": 5000,
			      "click": 0.3, "tone": 400, "decay": 0.05,
			      "volume": 0.7},
			"t": {"tone": 50, "sweep": 22, "fall": 0.1, "decay": 0.7,
			      "click": 0.35, "noise": 0.15, "noise_decay": 0.3,
			      "colour": 200},
			"b": {"tone": 800, "decay": 0.12, "click": 0.5}
		 }}
	]
}
