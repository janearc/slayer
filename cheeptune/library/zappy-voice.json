{
	// zappy's small voice, for the ident and the three beds, made of the
	// sounds the owner kept. the tune is @wire-harp's lead exactly: a
	// bright plucked string, answered a quarter of a beat later by a
	// duller one on the right. the floor is @night-pad's chords exactly:
	// two detuned saws under a low filter that swell in slowly, doubled
	// left and right. the bass is @night-pad's. the drums are small and
	// dry: a soft low kick (k), a brush of noise (s), a clock's tick (h),
	// a soft open hat (o), a low tom (t) and a small metal tock (b). nothing struck, no bells. picked by the
	// composer on 2026-11-12 with nobody listening.
	"name": "zappy-voice",
	"machine": "studio",
	"master": 0.4,
	"reverb": {"size": 0.7, "decay": 2.8, "damping": 0.5, "level": 0.4},
	"channels": [
		{"kind": "pluck", "role": "lead", "volume": 0.9, "place": -0.25,
		 "send": {"reverb": 0.35},
		 "pluck": {"brightness": 0.95, "damping": 0.12, "position": 0.1,
		           "decay": 4, "release": 0.8}},
		{"kind": "pluck", "echo": "lead", "delay": "1/4", "gain": 0.45,
		 "place": 0.45, "send": {"reverb": 0.5},
		 "pluck": {"brightness": 0.5, "damping": 0.4, "position": 0.3,
		           "decay": 3, "release": 0.8}},
		{"kind": "analog", "role": "pad", "volume": 0.4, "place": -0.5,
		 "send": {"reverb": 0.6},
		 "envelope": {"attack": 0.25, "decay": 1.5, "sustain": 0.8,
		              "release": 2.2},
		 "analog": {"oscillators": [{"shape": "saw", "detune": -9},
		                            {"shape": "saw", "detune": 9}],
		            "filter": {"cutoff": 700, "resonance": 0.2,
		                       "follow": 0.4, "amount": 1.2,
		                       "envelope": {"attack": 0.6, "decay": 2,
		                                    "sustain": 0.4,
		                                    "release": 2}}}},
		{"kind": "analog", "echo": "pad", "delay": "1/8", "gain": 0.8,
		 "volume": 0.4, "place": 0.5, "send": {"reverb": 0.6},
		 "envelope": {"attack": 0.3, "decay": 1.5, "sustain": 0.8,
		              "release": 2.2},
		 "analog": {"oscillators": [{"shape": "saw", "detune": -14},
		                            {"shape": "square", "width": 0.3,
		                             "detune": 12}],
		            "filter": {"cutoff": 600, "resonance": 0.2,
		                       "follow": 0.4}}},
		{"kind": "analog", "role": "bass", "volume": 0.8,
		 "envelope": {"attack": 0.02, "decay": 2, "sustain": 0.7,
		              "release": 0.4},
		 "analog": {"oscillators": [{"shape": "triangle"},
		                            {"shape": "square", "octave": 1,
		                             "level": 0.2}],
		            "filter": {"cutoff": 300, "resonance": 0,
		                       "follow": 0.6}}},
		{"kind": "drum", "role": "perc", "volume": 0.6, "place": 0.1,
		 "send": {"reverb": 0.3},
		 "drums": {
			"k": {"tone": 48, "sweep": 24, "fall": 0.06, "decay": 0.35,
			      "click": 0.1},
			"s": {"noise": 0.3, "noise_decay": 0.12, "colour": 2500},
			"h": {"tone": 1800, "decay": 0.015, "click": 0.6,
			      "noise": 0.15, "noise_decay": 0.02, "colour": 6000,
			      "volume": 0.6},
			"o": {"noise": 0.25, "noise_decay": 0.25, "colour": 6000},
			"t": {"tone": 85, "sweep": 6, "fall": 0.08, "decay": 0.35},
			"b": {"tone": 900, "decay": 0.06, "click": 0.7,
			      "volume": 0.6}
		 }}
	]
}
