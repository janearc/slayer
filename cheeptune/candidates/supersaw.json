{
	// intent: a bright lead that stays bright on held notes and still has a
	// shape to each note: four saws in two layers (left and right), the
	// filter opening on the front of each note and settling half open.
	// the chords and drums are @analog-drive's; the bass is a round
	// filtered saw under it.
	"name": "supersaw",
	"machine": "studio",
	"master": 0.43,
	"reverb": {"size": 0.3, "decay": 0.9, "damping": 0.4, "level": 0.3},
	"channels": [
		{"kind": "analog", "role": "lead", "volume": 0.4, "place": -0.4,
		 "send": {"reverb": 0.25},
		 "envelope": {"attack": 0.004, "decay": 0.4, "sustain": 0.55,
		              "release": 0.16},
		 "analog": {"oscillators": [{"shape": "saw", "detune": -9},
		                            {"shape": "saw", "detune": 9}],
		            "filter": {"cutoff": 4500, "resonance": 0.2,
		                       "follow": 0.8, "amount": 1.2,
		                       "envelope": {"attack": 0.002, "decay": 0.3,
		                                    "sustain": 0.5,
		                                    "release": 0.2}}}},
		{"kind": "analog", "role": "lead", "volume": 0.4, "place": 0.4,
		 "send": {"reverb": 0.25},
		 "envelope": {"attack": 0.004, "decay": 0.4, "sustain": 0.55,
		              "release": 0.16},
		 "analog": {"oscillators": [{"shape": "saw", "detune": -3},
		                            {"shape": "saw", "detune": 3}],
		            "filter": {"cutoff": 4500, "resonance": 0.2,
		                       "follow": 0.8, "amount": 1.2,
		                       "envelope": {"attack": 0.002, "decay": 0.3,
		                                    "sustain": 0.5,
		                                    "release": 0.2}}}},
		{"kind": "analog", "role": "pad", "volume": 0.5, "place": 0.4,
		 "send": {"reverb": 0.3},
		 "envelope": {"attack": 0.004, "decay": 0.4, "sustain": 0.4,
		              "release": 0.25},
		 "analog": {"oscillators": [{"shape": "square", "width": 0.25},
		                            {"shape": "saw", "detune": -8}],
		            "filter": {"cutoff": 2200, "resonance": 0.3,
		                       "follow": 0.5}}},
		{"kind": "analog", "role": "bass", "volume": 0.3,
		 "envelope": {"attack": 0.003, "decay": 0.25, "sustain": 0.5,
		              "release": 0.08},
		 "analog": {"oscillators": [{"shape": "saw"},
		                            {"shape": "triangle", "octave": -1}],
		            "filter": {"cutoff": 700, "resonance": 0.25,
		                       "follow": 0.5, "amount": 1.5,
		                       "envelope": {"attack": 0, "decay": 0.2,
		                                    "sustain": 0.3,
		                                    "release": 0.1}}}},
		{"kind": "drum", "role": "perc", "volume": 1.0,
		 "send": {"reverb": 0.15},
		 "drums": {
			"k": {"tone": 55, "sweep": 36, "fall": 0.035, "decay": 0.28,
			      "click": 0.6},
			"s": {"tone": 200, "sweep": 6, "fall": 0.03, "decay": 0.11,
			      "click": 0.4, "noise": 0.7, "noise_decay": 0.17,
			      "colour": 1500},
			"h": {"noise": 0.45, "noise_decay": 0.035, "colour": 8000},
			"t": {"tone": 130, "sweep": 12, "fall": 0.06, "decay": 0.22,
			      "click": 0.3},
			"o": {"noise": 0.45, "noise_decay": 0.28, "colour": 8000},
			"b": {"tone": 800, "decay": 0.12, "click": 0.5}
		 }}
	]
}
