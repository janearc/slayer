{
	// intent: a brass-like stab for the chords. two saws an octave apart,
	// a two-pole filter that opens fast on each chord and closes again,
	// short, so the chord is a blat and not a pad.
	"name": "brass-stab",
	"machine": "studio",
	"master": 0.4,
	"reverb": {"size": 0.4, "decay": 1.2, "damping": 0.4, "level": 0.25},
	"channels": [
		{"kind": "analog", "role": "lead", "volume": 0.7, "place": -0.1,
		 "send": {"reverb": 0.2},
		 "envelope": {"attack": 0.004, "decay": 0.4, "sustain": 0.4,
		              "release": 0.15},
		 "vibrato": {"rate": 5, "depth": 7, "delay": 0.25},
		 "analog": {"oscillators": [{"shape": "saw"},
		                            {"shape": "square", "detune": 6,
		                             "level": 0.6}],
		            "filter": {"cutoff": 2200, "resonance": 0.25,
		                       "follow": 0.8, "amount": 2,
		                       "envelope": {"attack": 0.002, "decay": 0.25,
		                                    "sustain": 0.3,
		                                    "release": 0.15}}}},
		{"kind": "analog", "role": "pad", "volume": 0.55, "place": 0.3,
		 "voices": 12, "send": {"reverb": 0.3},
		 "envelope": {"attack": 0.012, "decay": 0.3, "sustain": 0.35,
		              "release": 0.22},
		 "analog": {"oscillators": [{"shape": "saw", "detune": -6,
		                             "octave": 1},
		                            {"shape": "saw", "detune": 6,
		                             "octave": 1}],
		            "filter": {"cutoff": 700, "resonance": 0.3,
		                       "follow": 0.9, "amount": 3,
		                       "envelope": {"attack": 0.025, "decay": 0.22,
		                                    "sustain": 0.2,
		                                    "release": 0.15}}}},
		{"kind": "analog", "role": "bass", "volume": 0.36,
		 "envelope": {"attack": 0.004, "decay": 0.4, "sustain": 0.6,
		              "release": 0.12},
		 "analog": {"oscillators": [{"shape": "saw"},
		                            {"shape": "square", "octave": -1,
		                             "level": 0.6}],
		            "filter": {"cutoff": 500, "resonance": 0.2,
		                       "follow": 0.4, "amount": 1.5,
		                       "envelope": {"attack": 0, "decay": 0.2,
		                                    "sustain": 0.3,
		                                    "release": 0.1}}}},
		{"kind": "drum", "role": "perc", "volume": 0.8,
		 "send": {"reverb": 0.15},
		 "drums": {
			"k": {"tone": 52, "sweep": 30, "fall": 0.045, "decay": 0.3,
			      "click": 0.3},
			"s": {"tone": 190, "decay": 0.1, "noise": 0.5,
			      "noise_decay": 0.15, "colour": 1500},
			"h": {"noise": 0.35, "noise_decay": 0.04, "colour": 6000},
			"t": {"tone": 115, "sweep": 8, "fall": 0.07, "decay": 0.25},
			"o": {"noise": 0.35, "noise_decay": 0.25, "colour": 6000},
			"b": {"tone": 740, "decay": 0.12, "click": 0.3}
		 }}
	]
}
