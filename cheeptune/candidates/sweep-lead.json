{
	// intent: a lead whose colour sweeps on every note, the effect of a hard
	// sync lead, made honestly with fm: a carrier and a modulator at a whole
	// ratio of three, the modulator strong at the front of the note and
	// dying to a thin tone. the machine has no oscillator sync, so this is a
	// sweep of overtones, all whole multiples of the note. a quiet sine
	// bass; chords and drums are @analog-drive's.
	"name": "sweep-lead",
	"machine": "studio",
	"master": 0.36,
	"reverb": {"size": 0.3, "decay": 0.9, "damping": 0.4, "level": 0.3},
	"channels": [
		{"kind": "fm", "role": "lead", "volume": 0.7, "place": -0.1,
		 "glide": 0.07, "send": {"reverb": 0.25},
		 "fm": {"arrangement": "chain", "operators": [
			{"ratio": 1, "level": 0.8,
			 "envelope": {"attack": 0.003, "decay": 0.4, "sustain": 0.32,
			              "release": 0.16}},
			{"ratio": 3, "level": 0.32,
			 "envelope": {"attack": 0, "decay": 0.55, "sustain": 0.12,
			              "release": 0.15}}]}},
		{"kind": "analog", "role": "pad", "volume": 0.5, "place": 0.4,
		 "send": {"reverb": 0.3},
		 "envelope": {"attack": 0.004, "decay": 0.4, "sustain": 0.4,
		              "release": 0.25},
		 "analog": {"oscillators": [{"shape": "square", "width": 0.25},
		                            {"shape": "saw", "detune": -8}],
		            "filter": {"cutoff": 2200, "resonance": 0.3,
		                       "follow": 0.5}}},
		{"kind": "analog", "role": "bass", "volume": 0.24,
		 "envelope": {"attack": 0.003, "decay": 0.3, "sustain": 0.6,
		              "release": 0.08},
		 "analog": {"oscillators": [{"shape": "square"},
		                            {"shape": "triangle", "octave": -1}],
		            "filter": {"cutoff": 500, "resonance": 0.2,
		                       "follow": 0.4, "amount": 1.2,
		                       "envelope": {"attack": 0, "decay": 0.2,
		                                    "sustain": 0.4,
		                                    "release": 0.1}}}},
		{"kind": "drum", "role": "perc", "volume": 1.0,
		 "send": {"reverb": 0.15},
		 "drums": {
			"k": {"tone": 55, "sweep": 36, "fall": 0.035, "decay": 0.28,
			      "click": 0.6},
			"s": {"tone": 200, "sweep": 6, "fall": 0.03, "decay": 0.11,
			      "click": 0.4, "noise": 0.7, "noise_decay": 0.17,
			      "colour": 1500},
			"h": {"noise": 0.45, "noise_decay": 0.035, "colour": 8000},
			"t": {"tone": 130, "sweep": 12, "fall": 0.06, "decay": 0.22,
			      "click": 0.3},
			"o": {"noise": 0.45, "noise_decay": 0.28, "colour": 8000},
			"b": {"tone": 800, "decay": 0.12, "click": 0.5}
		 }}
	]
}
