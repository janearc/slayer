{
	// intent: a plucked lead for fast sixteenths: a hard pick near the
	// bridge, a short decay and a quick damp when the note ends, so a run of
	// fast notes stays separate and does not smear. the bass is a short
	// filtered saw. chords and drums are @analog-drive's.
	"name": "pluck-run",
	"machine": "studio",
	"master": 0.36,
	"reverb": {"size": 0.3, "decay": 0.9, "damping": 0.4, "level": 0.3},
	"channels": [
		{"kind": "pluck", "role": "lead", "volume": 0.75, "place": -0.15,
		 "send": {"reverb": 0.2},
		 "pluck": {"brightness": 0.9, "damping": 0.3, "position": 0.15,
		           "decay": 1.2, "release": 0.12}},
		{"kind": "analog", "role": "pad", "volume": 0.3, "place": 0.4,
		 "send": {"reverb": 0.3},
		 "envelope": {"attack": 0.004, "decay": 0.4, "sustain": 0.4,
		              "release": 0.25},
		 "analog": {"oscillators": [{"shape": "square", "width": 0.25},
		                            {"shape": "saw", "detune": -8}],
		            "filter": {"cutoff": 2200, "resonance": 0.3,
		                       "follow": 0.5}}},
		{"kind": "analog", "role": "bass", "volume": 0.2,
		 "envelope": {"attack": 0.002, "decay": 0.22, "sustain": 0.35,
		              "release": 0.07},
		 "analog": {"oscillators": [{"shape": "saw"}],
		            "filter": {"cutoff": 600, "resonance": 0.3,
		                       "follow": 0.5, "amount": 2,
		                       "envelope": {"attack": 0, "decay": 0.15,
		                                    "sustain": 0.2,
		                                    "release": 0.08}}}},
		{"kind": "drum", "role": "perc", "volume": 1.0,
		 "send": {"reverb": 0.15},
		 "drums": {
			"k": {"tone": 55, "sweep": 36, "fall": 0.035, "decay": 0.28,
			      "click": 0.6},
			"s": {"tone": 200, "sweep": 6, "fall": 0.03, "decay": 0.11,
			      "click": 0.4, "noise": 0.7, "noise_decay": 0.17,
			      "colour": 1500},
			"h": {"noise": 0.45, "noise_decay": 0.035, "colour": 8000},
			"t": {"tone": 130, "sweep": 12, "fall": 0.06, "decay": 0.22,
			      "click": 0.3},
			"o": {"noise": 0.45, "noise_decay": 0.28, "colour": 8000},
			"b": {"tone": 800, "decay": 0.12, "click": 0.5}
		 }}
	]
}
