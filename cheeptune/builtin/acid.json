{
	// the studio machine. acid, second cut. the first was tossed:
	// measured against the driven voicing that was kept, it was
	// darker, every note flattened to a steady buzz, the bass too loud
	// and the chords lost. this one is that kept voicing's bright saw
	// turned toward acid: one saw each for lead and bass through the
	// four-pole filter, an envelope that snaps it open on every note
	// and leaves it a quarter open while the note is held, accents and
	// slides from the score, overdrive before the note's own envelope
	// so a note still barks and dies. the chords are the kept voicing's.
	"name": "acid",
	"machine": "studio",
	"master": 0.36,
	"reverb": {"size": 0.3, "decay": 0.9, "damping": 0.4, "level": 0.3},
	"channels": [
		{"kind": "analog", "role": "lead", "volume": 0.7, "place": -0.1,
		 "glide": 0.05, "send": {"reverb": 0.25},
		 "envelope": {"attack": 0.003, "decay": 0.5, "sustain": 0.6,
		              "release": 0.18},
		 "analog": {"oscillators": [{"shape": "saw"}],
		            "overdrive": 0.3,
		            "filter": {"poles": 4, "cutoff": 2000,
		                       "resonance": 0.7, "follow": 0.7,
		                       "amount": 2.8, "accent": 1.2, "snap": 0.5,
		                       "envelope": {"attack": 0.002,
		                                    "decay": 0.3,
		                                    "sustain": 0.25,
		                                    "release": 0.2}}}},
		{"kind": "analog", "role": "pad", "volume": 0.6, "place": 0.4,
		 "send": {"reverb": 0.3},
		 "envelope": {"attack": 0.004, "decay": 0.4, "sustain": 0.4,
		              "release": 0.25},
		 "analog": {"oscillators": [{"shape": "square", "width": 0.25},
		                            {"shape": "saw", "detune": -8}],
		            "filter": {"cutoff": 2200, "resonance": 0.3,
		                       "follow": 0.5}}},
		{"kind": "analog", "role": "bass", "volume": 0.45, "glide": 0.06,
		 "envelope": {"attack": 0.002, "decay": 0.3, "sustain": 0.7,
		              "release": 0.1},
		 "analog": {"oscillators": [{"shape": "saw"}],
		            "overdrive": 0.4,
		            "filter": {"poles": 4, "cutoff": 800,
		                       "resonance": 0.72, "follow": 0.5,
		                       "amount": 3, "accent": 1.5, "snap": 0.5,
		                       "envelope": {"attack": 0, "decay": 0.25,
		                                    "sustain": 0.25,
		                                    "release": 0.1}}}},
		{"kind": "drum", "role": "perc", "volume": 0.9,
		 "send": {"reverb": 0.12},
		 "drums": {
			"k": {"tone": 48, "sweep": 36, "fall": 0.04, "decay": 0.5,
			      "click": 0.7},
			"s": {"tone": 185, "sweep": 5, "fall": 0.02, "decay": 0.07,
			      "click": 0.5, "noise": 0.8, "noise_decay": 0.16,
			      "colour": 1200},
			"h": {"noise": 0.45, "noise_decay": 0.03, "colour": 9000},
			"o": {"noise": 0.4, "noise_decay": 0.3, "colour": 7500},
			"t": {"tone": 130, "sweep": 12, "fall": 0.06, "decay": 0.22,
			      "click": 0.3},
			"b": {"tone": 800, "decay": 0.12, "click": 0.5}
		 }}
	]
}
